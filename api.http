@baseUrl = http://localhost:8000
@suggestionId = 8fdd8b8e-8de4-4b9a-8e16-868b72f4f469
@orderId = ce6ce7b9-72c2-4f5a-88b7-eb1f923c2609
@bookingId = d4b9f6a2-7c3e-4a1b-9f2d-5e8c3a7b9f10

### Add customer to order
POST {{baseUrl}}/api/orders/{{orderId}}/customer
Content-Type: application/json
Accept: application/json

{
    "salutation": "Mr.",
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe@example.com",
    "agreeToTerms": true
}

### Get order by booking id
GET {{baseUrl}}/api/orders/{{bookingId}}
Accept: application/json

### Create suggestion
POST {{baseUrl}}/api/suggestions
Content-Type: application/json
Accept: application/json

{
    "email": "user3@example.com",
    "title": "Improve booking performance",
    "description": "Cache frequently requested movie data to reduce latency."
}

### Pay order
POST {{baseUrl}}/api/orders/{{orderId}}/payments
Content-Type: application/json
Accept: application/json

{
    "externalId": "e98281ee-60bb-4838-a44f-1cc3f2ddec4a",
    "paymentMethod": "CREDIT_CARD",
    "cardNumber": "4111111111111111",
    "expiryDate": "12/25",
    "cvv": "123",
    "bookingId": "{{bookingId}}",
    "amount": 19.99
}


### Get all suggestions
GET {{baseUrl}}/api/suggestions
Accept: application/json

### Get suggestion by id
GET {{baseUrl}}/api/suggestions/{{suggestionId}}
Accept: application/json
